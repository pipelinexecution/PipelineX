# ── Email (Gmail) ─────────────────────────────────────────
# Your Gmail address
SMTP_USER=hello@pipelinex.in

# Gmail App Password (NOT your Gmail password)
# How to get it: Google Account → Security → 2-Step Verification → App passwords
# Generate one for "Mail" → copy the 16-char password here
SMTP_PASS=xxxx xxxx xxxx xxxx

# Where audit notifications are sent (can be same as SMTP_USER)
NOTIFY_EMAIL=hello@pipelinex.in

# ── Admin dashboard ───────────────────────────────────────
# Make this long and random — it's your dashboard password
# Example: openssl rand -hex 24
ADMIN_TOKEN=change_this_to_something_secret_and_long

# ── App ───────────────────────────────────────────────────
PORT=3000

# Your live domain once deployed (for email links)
BASE_URL=https://pipelinex.up.railway.app
